{
  "name": "lostfound-backend",
  "version": "2.0.0",
  "description": "Lost & Found backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "docker:build": "docker build -t lostfound-api:latest .",
    "docker:run": "docker run --env-file .env -p 3000:3000 lostfound-api:latest",
    "docker:compose": "docker compose up --build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.2",
    "@azure/storage-blob": "^12.31.0",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}