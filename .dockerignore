# Dependencies (re-installed inside image)
node_modules/

# Environment secrets — NEVER bake into image
.env
.env.*
!.env.example

# Version control
.git/
.gitignore

# Dev / editor artefacts
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
*.test.js
*.spec.js
__tests__/

# Local uploads directory (uploads go to Azure Blob, not disk)
uploads/

# Docker files themselves (avoid recursive COPY confusion)
Dockerfile
.dockerignore
docker-compose*.yml

# Infrastructure-as-code (not needed inside container)
terraform/

# Documentation
*.md
README*
